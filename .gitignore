# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/
.eggs/

# Virtual environments
.env
.venv
env/
venv/

# Preuves : jamais dans le dépôt (captures, images disque, mémoire, journaux Windows, bases)
*.pcap
*.pcapng
*.cap
*.binary
*.memory
*.mem
*.vmem
*.dmp
*.lime
*.raw
*.dd
*.img
*.E01
*.001
*.iso
*.sqlite
*.evtx
*.registry
*.linux
*.image
*.disque
*.timel
*.bin
*.pf
*.lnk
*.DAT

# Documents et archives (cours, rapports de TP, pièces jointes) : jamais dans le dépôt
*.doc
*.docx
*.docm
*.dot
*.dotm
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.pptm
*.odt
*.ods
*.odp
*.rtf
*.msg
*.eml
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
__MACOSX/
~$*
TEST_FORENSICTOOL/
lab/*

# Rapports générés : dans export/ (dossier d'affaire), lib/ (sortie pyvis) ou à la racine
export/
lib/
/*.json
/*.csv
/*.html
/*.pdf
/*.png
/*.yar
/*.rules

# Tests
/test_samples/*
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Editor and OS files
.vscode/
.idea/
.DS_Store
*.swp
*.swo
Thumbs.db

# Logs and runtime
*.log
*.pid
*.sqlite3

# Notes personnelles
agent.md
OUTILS.md
VERSION.md
VERSIONS.md
INTEGRATION.md

# Fixtures de tests (versionnées malgré les règles ci-dessus)
!tests/**
# ... sauf leurs caches (la règle ci-dessus les ré-inclurait)
__pycache__/
*.py[cod]

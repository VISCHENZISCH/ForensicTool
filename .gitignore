*.log
*.pid
*.sqlite3
lab/*

# Rapports générés (export/, sortie pyvis lib/) et fichiers produits par les analyses
export/
lib/
*.json
*.csv
*.html
*.HTML
*.pdf
*.png
*.jpg
*.jpeg
*.gif
